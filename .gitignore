public/
# Hugo's image and asset cache, rebuilt on every build
hugo/resources/

# The hugo-book theme was removed when the site was rebuilt as a knowledge graph;
# all layouts are first-party under hugo/layouts/. hugo/hugo.toml declares no
# theme, so anything that reappears here is inert. Ignored rather than deleted-
# only, because `git add -A` in this repo otherwise sweeps up a 5.6 MB clone and
# resurrects the architecture the site moved away from.
hugo/themes/

# Terraform: generated Lambda deployment artifacts
terraform/files/contrib-dispatch.zip
terraform/files/contact.zip
terraform/files/subscribe.zip
terraform/files/subscribe-layer.zip
terraform/files/aigp-sync.zip
# Python bytecode (e.g. from local Lambda syntax checks)
__pycache__/

# The mockup draws the site's own mermaid diagrams with the site's own bundle.
# It is not committed twice: run mockups/01-typographic/tools/sync-vendor.sh
# (documented in mockups/README.md) to copy it out of hugo/assets/js/vendor.
mockups/*/assets/mermaid.min.js
mockups/*/assets/d3.min.js
